# ==========================================================
# Absensi Digital SMA Trinitas - contoh konfigurasi
# Salin file ini menjadi .env lalu sesuaikan nilainya.
# ==========================================================

# Server
PORT=3000
NODE_ENV=development
# Aktifkan saat berjalan di belakang Nginx/Caddy/Cloudflare.
# Nilai "1" membuat Express membaca X-Forwarded-* dengan benar.
TRUST_PROXY=0

# Keamanan - WAJIB diganti dengan string acak panjang (>= 32 karakter).
# Contoh membuat: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ganti-dengan-string-acak-panjang-minimal-32-karakter
JWT_EXPIRES=7d

# Cookie: aktifkan true hanya jika situs sudah memakai HTTPS.
COOKIE_SECURE=false

# Kode rahasia untuk pendaftaran akun staf (guru/wali kelas/BK).
STAFF_CODE=TRINITAS-STAF-2026

# Akun admin pertama. Dibuat otomatis saat server pertama kali dijalankan.
ADMIN_NAME=Administrator Sekolah
ADMIN_EMAIL=admin@trinitas.sch.id
ADMIN_PASSWORD=Admin#12345

# Lokasi database SQLite.
DATABASE_PATH=./data/absensi.db

# Data demo (siswa, orang tua, guru, riwayat absensi).
# Biarkan false untuk data sekolah sebenarnya. Aktifkan true hanya saat
# pengembangan di database kosong.
SEED_DEMO=false
SHOW_DEMO_ACCOUNTS=false

# Tampilkan jam server di log.
LOG_REQUESTS=false
